# Haven backend configuration. Copy to `.env` at the repo root (`cp .env.example .env`).
# `npm run dev:api` loads `.env` automatically. Never commit `.env`.
#
# SAFETY: PHOTON_MODE=mock (the default) never contacts anyone. It records outbound
# messages in the local database only. Switch to live only with consenting test contacts.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Hono API listens on.
PORT=8787

# SQLite database file. Created on first start. `:memory:` is allowed for throwaway runs.
DATABASE_PATH=./data/haven.db

# Directory where finalized emergency audio recordings (WAV) are stored.
AUDIO_STORAGE_PATH=./data/recordings

# Public origin of this API, used to build secure recording links (`/r/<token>`) that are
# sent to emergency contacts. Must be HTTPS and reachable by contacts in live mode.
PUBLIC_BASE_URL=http://localhost:8787

# Comma-separated list of browser origins allowed by CORS, or `*`.
# Haven authenticates with bearer tokens (no cookies), so `*` does not expose credentials.
# The packaged Even Hub WebView origin is not documented; keep `*` until it is verified on hardware.
ALLOWED_ORIGINS=*

# ── Enrollment (hackathon-grade auth, not a production identity system) ──────
# Shared pairing code the wearer types into the Haven phone UI once. It is exchanged for a
# scoped session token. Live mode rejects codes shorter than 12 characters and this example value.
HAVEN_PAIRING_CODE=change-me-pairing-code

# The wearer's name as emergency contacts know it, used in the SOS text ("Jaden has activated a
# Haven emergency alert"). Optional; at most 40 characters. Without it the SOS cannot say who.
HAVEN_WEARER_NAME=

# ── Photon 2.0 (Beta) messaging ──────────────────────────────────────────────
# `mock` (default) or `live`. Live mode calls https://api.photon.codes/v1 and sends real messages.
PHOTON_MODE=mock

# Project API key (`pho_sk_...`) with project:read and project:write, plus platforms:read and
# platforms:write when PHOTON_LINE_MODE=shared (Haven assigns each contact a shared line).
# Server-side only.
PHOTON_API_KEY=

# Photon project ID (`pho_prj_...`).
PHOTON_PROJECT_ID=

# `shared` (default): Photon's pooled shared iMessage lines. Each contact gets their own line
#   assignment (one plan seat each); the wearer's contacts list shows the number each contact
#   must text to opt in, and Haven learns that line's sender from the contact's first text.
# `dedicated`: one project-owned line for everyone; set PHOTON_AGENT_USER_ID and
#   PHOTON_LINE_NUMBER.
PHOTON_LINE_MODE=shared

# The number every contact texts when they all use one line (dedicated lines, or mock demos).
# E.164, e.g. +16283167976. Shown to the wearer as each contact's opt-in number.
PHOTON_LINE_NUMBER=

# Photon User ID of Haven's agent line (`pho_usr_...`), sent as `senderId`. Required only for
# PHOTON_LINE_MODE=dedicated; shared lines learn it per contact.
PHOTON_AGENT_USER_ID=

# Messaging platform for emergency contacts. `imessage` (shared line) or `sms`.
# A shared iMessage line can only message contacts who have texted it first, so every
# contact must opt in by messaging Haven's line before they can receive an SOS.
PHOTON_PLATFORM=imessage

# Signing secret (`whsec_...`) returned when the Photon webhook destination was created
# (`npm run photon:webhook -w @haven/api -- create https://<your-api-host>`).
# Required in live mode so forged webhooks cannot inject fake contact replies.
PHOTON_WEBHOOK_SECRET=

# ── AI emergency context (Google Gemini 2.5 Flash-Lite only) ─────────────────
# `mock` (default) or `live`. The SOS never waits for this; failures only skip the AI follow-up.
LLM_MODE=mock

# OpenAI-compatible endpoint. Gemini's OpenAI compatibility layer:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Gemini API key. Server-side only; never ship it in the G2 bundle.
LLM_API_KEY=

# Haven requires exactly this model. The server refuses to start with any other value.
LLM_MODEL=gemini-2.5-flash-lite
