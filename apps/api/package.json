{
  "name": "@haven/api",
  "version": "0.1.0",
  "private": true,
  "description": "Haven backend: Hono + SQLite. Sends emergency messages through Photon 2.0 and runs AI context analysis.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "vitest run --project api",
    "photon:webhook": "node --env-file-if-exists=../../.env scripts/photon-webhook.mjs"
  },
  "dependencies": {
    "@haven/contracts": "0.1.0",
    "@hono/node-server": "^2.1.5",
    "@photon-ai/api": "0.5.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
