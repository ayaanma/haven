# G2 app build-time configuration. Copy to apps/g2/.env.local. Vite exposes only VITE_* values,
# and they end up in the .ehpk bundle: never put API keys here.

# Base URL of the Haven API. For QR sideloading on a real phone, use your laptop's LAN IP,
# e.g. http://192.168.1.20:8787. `npm run pack` also writes this origin into the app.json
# network whitelist of the packaged build.
VITE_HAVEN_API_BASE_URL=http://localhost:8787
